# Environment
APP_ENV=qa

# Optional Funtime public-site origin; defaults to https://funtime.com.ua
FUNTIME_BASE_URL=https://funtime.com.ua

# Web application
WEB_APP_URL=http://localhost/opencart/upload/
# Alternatives:
# WEB_APP_URL=https://tutorialsninja.com/demo/
# WEB_APP_URL=https://awesomeqa.com/ui/

# Web application credentials — set your own values in .env
APP_EMAIL=YOUR_APP_EMAIL
APP_PASSWORD=YOUR_APP_PASSWORD

# Product test data
PRODUCT_NAME=MacBook
PRODUCT_QUANTITY=1
TOTAL_PRICE=602.00

# API
API_BASE_URL=https://fakestoreapi.com
API_USERNAME=YOUR_API_USERNAME
API_PASSWORD=YOUR_API_PASSWORD
API_USER_ID=1
API_PRODUCT_ID=1
API_CART_ID=1
API_LIMIT=3
API_START_DATE=2019-12-10
API_END_DATE=2020-10-10

# Optional basic authentication
BASIC_AUTH_USERNAME=YOUR_BASIC_AUTH_USERNAME
BASIC_AUTH_PASSWORD=YOUR_BASIC_AUTH_PASSWORD

# Optional API credentials
API_KEY=YOUR_API_KEY
ACCESS_TOKEN=YOUR_ACCESS_TOKEN

# Optional OAuth2 credentials
OAUTH_CLIENT_ID=YOUR_CLIENT_ID
OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET
OAUTH_AUTHORIZATION_CODE=YOUR_AUTHORIZATION_CODE
OAUTH_TOKEN_URL=YOUR_TOKEN_URL

# Database — set local test database values in .env
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=openshop
DB_PORT=3306

# Admin application credentials — set your own values in .env
ADMIN_USERNAME=YOUR_ADMIN_USERNAME
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
